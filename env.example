# SMTP credentials used to email new repair/build bookings to the admin inbox.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
# SMTP_SECURE=true
SMTP_USER=your-smtp-username
SMTP_PASSWORD=your-smtp-password
SMTP_FROM=PC Xpress <bookings@pc-xpress.co.uk>

# Where booking notification emails are sent. Falls back to SMTP_USER if unset.
BOOKING_ADMIN_EMAIL=admin@pc-xpress.co.uk

# Supabase project (Project Settings -> API in the Supabase dashboard).
# Backs the customer-facing catalogs: Prebuilt PCs, Custom Build parts/
# categories, and the Repairs device/brand/fault catalog. Run
# supabase/schema.sql once in the SQL Editor before using the app.
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-anon-key
# Optional: bypasses RLS for admin writes. Server-side only, never exposed
# to the browser. If unset, admin writes fall back to the publishable key.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Comma-separated allowlist of permanent "owner" emails for /dashboard —
# checked in proxy.ts and again in app/dashboard/layout.tsx. There's no
# public sign-up; owners are the bootstrap admins, and can add more admins
# from the dashboard's Settings > Admin Users panel (see supabase/admin-users.sql).
ADMIN_EMAILS=you@example.com,partner@example.com

# Stripe (test keys from https://dashboard.stripe.com/test/apikeys). Powers
# the pre-built PC checkout flow (app/(marketing)/checkout).
STRIPE_SECRET_KEY=sk_test_your-secret-key
# From `stripe listen --forward-to localhost:3000/api/webhooks/stripe` in
# development, or the webhook endpoint's signing secret in the Stripe
# Dashboard in production. Required for orders to flip from "Awaiting
# Payment" to "Processing" after a successful payment.
STRIPE_WEBHOOK_SECRET=whsec_your-webhook-secret
# Optional: overrides the auto-detected request origin when building Stripe
# success/cancel redirect URLs (useful behind a proxy/custom domain).
NEXT_PUBLIC_SITE_URL=http://localhost:3000